# backend/Dockerfile

FROM python:3.10-slim-buster

# Устанавливаем рабочую директорию в контейнере.
# Все последующие команды будут выполняться относительно этой директории.
WORKDIR /app

# Копируем файл с зависимостями из вашего локального проекта в рабочую директорию контейнера.
COPY requirements.txt requirements.txt

# Устанавливаем зависимости. --no-cache-dir помогает уменьшить размер образа.
RUN pip install --no-cache-dir -r requirements.txt

# Копируем все остальные файлы вашего Flask-приложения (app.py, Dockerfile, docker-compose.yml и т.д.)
# в рабочую директорию контейнера.
COPY . .

# Открываем порт 5000. Это стандартный порт для Flask.
# Указывает Docker, что контейнер будет слушать на этом порту.
EXPOSE 5000

# Команда, которая будет выполняться при запуске контейнера.
# Мы будем использовать `python app.py`, как вы запускали локально.
# Если вы используете `flask run`, то команда будет `CMD ["flask", "run", "--host=0.0.0.0", "--port=5000"]`
# Но так как вы запускали `app.run(...)`, то `CMD ["python", "app.py"]` будет работать.
CMD ["python", "app.py"]