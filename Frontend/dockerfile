# frontend/Dockerfile.frontend
# FROM node:22-alpine as builder
FROM node:22

WORKDIR /app

# Копируем package.json и package-lock.json
COPY ./package.json ./package-lock.json ./
RUN npm install

# Копируем остальной код Vue
# COPY ./ .
COPY . .

# # Собираем Vue-приложение для продакшена
# RUN npm run build
#
# # --- Stage 2: Setup Nginx ---
# FROM nginx:alpine
#
# # Копируем собранные файлы Vue из builder stage в директорию Nginx
# COPY --from=builder /app/dist /usr/share/nginx/html
#
# # Копируем нашу кастомную конфигурацию Nginx
# COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Nginx будет слушать порт 80 внутри контейнера
# EXPOSE 80
EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# CMD ["nginx", "-g", "daemon off;"] # Обычно это уже есть в базовом образе nginx:alpine