{
  "files": [],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ESNext", "DOM"],
    "sourceMap": true,

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@": ["./src"],
    }
  },
  "include": [
    "env.d.ts",
    "./src/**/*",
    "./src/**/*.vue",
    "vite.config.ts"
  ],
  "exclude": [
    "./src/**/__tests__/*",
    "node_modules"
  ]
}
